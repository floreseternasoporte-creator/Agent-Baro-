# ═══════════════════════════════════════════════════════════
# Baro — variables de entorno (copia este archivo a ".env")
#   cp .env.example .env
# FIREBASE_PROJECT_ID es obligatorio para validar usuarios en la API.
# El resto es opcional; sin clave de Groq, Baro usa Pollinations gratis.
# Nunca subas tu .env real a GitHub: ya está en .gitignore.
# ═══════════════════════════════════════════════════════════

# Firebase Auth: debe coincidir con projectId de firebase-auth.js.
FIREBASE_PROJECT_ID=ggggg-f2508

# Groq (Llama 3.3 70B, gratis con clave de console.groq.com/keys).
# Es el primer proveedor de la cadena; sin clave se salta a Pollinations.
GROQ_API_KEY=

# Tavily: búsqueda web en tiempo real e investigación profunda
# (gratis, 1000 búsquedas/mes en tavily.com).
TAVILY_API_KEY=

# BytePlus ModelArk: generación de video con Seedance (de pago).
# Sin clave, todo lo demás funciona; solo se desactiva el video.
BYTEPLUS_API_KEY=

# GitHub: token del servidor para clonar/pushear repos sin que cada
# usuario conecte su cuenta (la app también ofrece OAuth Device Flow).
GITHUB_TOKEN=

# Token opcional para proteger la API del agente. Si se define,
# el frontend debe enviarlo en la cabecera "x-agent-token".
AGENT_API_TOKEN=

# Orígenes CORS permitidos (separados por comas). Vacío = mismo origen.
CORS_ORIGIN=

# Puerto del servidor (Railway lo asigna solo; en local, 3000 por defecto).
PORT=
